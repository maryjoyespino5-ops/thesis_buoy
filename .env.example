# Copy this file to `.env.local` (for Vite) or set env vars in Vercel
# Client (browser) variables must start with VITE_ to be exposed to the app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only key (do NOT expose to the browser). Use in Vercel server environment.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side Supabase URL (used by Vercel serverless functions)
SUPABASE_URL=
